        <bblocks://ogc.api.common.part1.clauses.abbreviated-terms>,
        <bblocks://ogc.api.common.part1.clauses.conformance>,
        <bblocks://ogc.api.common.part1.clauses.conventions>,
        <bblocks://ogc.api.common.part1.clauses.encodings>,
        <bblocks://ogc.api.common.part1.clauses.media-types>,
