<https://jfarduino.github.io/ogcapi-common-standards-as-bblocks/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - OGC API - Common - Part 1 (Standard as Building Blocks)" ;
    dct:abstract """OGC API — Common — Part 1: Core (OGC 19-072) authored as Building Blocks: every clause,
requirements class, term, reference and annex of the Standard is a Building Block, and the
standards document is generated from them.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """This repository contains the Building Blocks for
[OGC API — Common — Part 1: Core](https://docs.ogc.org/is/19-072/19-072.html) (OGC 19-072, version 1.0.0),
following the "OGC Standards as Building Blocks" approach: normative requirements, abstract tests,
test resources and prose are co-located in Building Blocks, and the HTML standards document is
generated from them by [bblocks-specgen](https://github.com/ogcincubator/bblocks-specgen)
(see `standards.yaml`).

The requirements reference the reusable OGC API — Common components (schemas, paths, responses)
published in the [OGC API — Common Building Blocks register](https://ogcincubator.github.io/bblocks-ogcapi-common/).
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:license [ rdfs:label "OGC License Agreement" ;
            rdfs:seeAlso <https://www.ogc.org/license> ] ;
    dct:modified "2026-11-10T16:38:26.482447"^^xsd:dateTime ;
    owl:imports <https://ogcincubator.github.io/bblocks-ogcapi-common/build/register.json>,
        <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.api.common.part1.annexes.ats>,
        <bblocks://ogc.api.common.part1.annexes.bibliography>,
